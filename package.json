{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run check:skills && npm run check:docs && npm run check:dead-code",
    "check:dead-code": "knip --no-progress",
    "check:docs": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "check:skills": "node scripts/check-repo-skills.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:e2e": "ASTRAA_ENABLE_ANALYTICS=false ASTRAA_E2E_FIXTURES=true ASTRAA_DISABLE_SENTRY_SOURCE_MAPS=true next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "npm run check:dead-code",
    "lint": "eslint . --max-warnings 0",
    "measure:performance": "node scripts/measure-performance.mjs",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
