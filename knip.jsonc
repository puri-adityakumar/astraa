{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    // Sentry configuration is loaded by the framework integration.
    "sentry.*.config.ts",

    // Browser workers are loaded through new Worker(new URL(...)).
    "lib/json/parse-worker.ts",
    "lib/regex-tester/redos-worker.ts",
  ],
  "project": [
    "app/**/*.{js,jsx,ts,tsx}",
    "components/**/*.{js,jsx,ts,tsx}",
    "**/*.css",
    "hooks/**/*.{js,jsx,ts,tsx}",
    "lib/**/*.{js,jsx,ts,tsx}",
    "*.{js,ts,mjs}",
  ],
  "next": true,
  "vitest": true,
  "treatConfigHintsAsErrors": true,
  "ignoreIssues": {
    // Used design-system primitives intentionally keep their complete public API.
    "components/ui/**": ["exports", "types"],
  },
}
