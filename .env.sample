# Environment Configuration
# Copy this file to .env.local and fill in your values

# OpenRouter API Key for AI text generation
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# CoinGecko demo API key. This value is server-only.
COINGECKO_API_KEY=your_coingecko_api_key_here

# Durable anonymous rate limiting for public provider-backed features.
KV_REST_API_URL=your_upstash_redis_rest_url_here
KV_REST_API_TOKEN=your_upstash_redis_rest_token_here
RATE_LIMIT_SALT=replace_with_a_long_random_server_only_value

# Optional privacy-minimal error monitoring. Sentry stays disabled unless both
# a DSN and environment are configured for the relevant runtime.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Optional build-only token for uploading source maps in CI.
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Production aggregate page-view and performance telemetry. Set to false to
# omit both Vercel Analytics and Speed Insights.
ASTRAA_ENABLE_ANALYTICS=true
