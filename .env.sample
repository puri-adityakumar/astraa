# Environment Configuration
# Copy this file to .env.local and fill in your values

# Environment mode: 'dev' or 'prod'
# In dev: WIP features are visible for testing
# In prod: WIP features show "Coming Soon" card
NEXT_PUBLIC_ENV=dev

# Sentry Auth Token (optional, for error tracking)
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# CoinGecko demo API key (optional, server-only, used by /api/crypto-price)
# Never prefix it with NEXT_PUBLIC_: the browser must not receive it.
# Leave empty to disable live crypto prices; the converter shows its
# price-unavailable state and no provider request is made.
COINGECKO_API_KEY=

# Upstash Redis / Vercel KV (optional, for the home page visitor counter)
# Leave empty to skip visitor counting
KV_REST_API_URL=
KV_REST_API_TOKEN=
